# Copy to .env and adjust. .env is gitignored; never put real keys in this file.

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://recsys:recsys@localhost:5439/recsys

# --- API ----------------------------------------------------------------------
API_PORT=8800
LOG_LEVEL=INFO
LOG_JSON=false

# --- Embeddings ---------------------------------------------------------------
# The DEFAULT index. Any provider with credentials can be indexed and searched
# alongside it — this only decides what a request gets when it names no provider.
# local_hash | jina | cohere
#   local_hash : offline deterministic stand-in. No API key, no model download.
#                Text->text and image->image search work; cross-modal does NOT.
#   jina       : jina-embeddings-v4, text + images in one shared space (free tier).
#   cohere     : embed-v4.0, text + images in one shared space (trial tier).
EMBEDDING_PROVIDER=local_hash

# Vector width, shared by every provider so one column and one index definition
# serve all of them. Changing this requires re-running migrations and re-indexing.
#   jina   supports 1..2048   cohere supports 256 | 512 | 1024 | 1536
EMBEDDING_DIM=512

# Any provider with a key can be indexed and searched alongside the others.
JINA_API_KEY=
COHERE_API_KEY=

# Voyage: voyage-multimodal-3.5 supports 256/512/1024/2048 dims. The older
# voyage-multimodal-3 is FIXED at 1024 — using it means EMBEDDING_DIM=1024 and a
# full re-index of every provider.
VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-multimodal-3.5

# Gemini: gemini-embedding-001 is TEXT-ONLY (only gemini-embedding-2 is multimodal),
# so products carry no image vector on this index and image search is unavailable.
# Most generous recurring free tier of the hosted options.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-embedding-001

# --- Ranking defaults ---------------------------------------------------------
# Weight of the text vector when fusing text and image similarity (0..1).
DEFAULT_TEXT_WEIGHT=0.6
# Candidates pulled from the ANN index before exact re-ranking.
ANN_CANDIDATE_MULTIPLIER=8

# Relevance cutoffs, to stop weak matches padding out the results page.
# Ratio: drop hits scoring below this fraction of the best hit (scale-free).
DEFAULT_MIN_SCORE_RATIO=0.45
# A single absolute floor across all providers. Leave unset to use the
# per-provider floors in app/core/config.py, which are calibrated separately
# because providers spread their scores very differently.
# DEFAULT_MIN_SCORE=0.4

# --- Rate limiting ------------------------------------------------------------
# Client-side pacing per provider, requests per minute (0 = unlimited). Free tiers
# are strict: Voyage without a payment method allows 3 RPM / 10K TPM, and pacing at
# exactly 3 still trips — hence 2. Raise these once billing is enabled.
# PROVIDER_RPM={"jina":60,"cohere":60,"gemini":100,"voyage":2}

# Images per embedding request. Images are billed by pixel and dwarf text; measured
# on Voyage's free tier, 4 images succeed and 8 return 429.
# PROVIDER_IMAGE_BATCH={"voyage":4}

# Products embedded per request batch during a re-index.
# REINDEX_BATCH_SIZE=16

# --- Admin --------------------------------------------------------------------
# Enables the UI-driven seed / re-index / clear endpoints. Turn OFF anywhere the
# API is reachable by anyone but you — these endpoints delete data.
ADMIN_ENABLED=true
